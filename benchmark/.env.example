# Copy this file to .env. This key belongs only to the standalone Python constructor.
# Explicit selection; never automatically falls back to another provider or model.
PROMPT_PROVIDER=vapi
VAPI_API_KEY=your-vapi-key-here
VAPI_BASE_URL=https://api.gpt.ge/v1
VAPI_TIMEOUT_SECONDS=240
VAPI_PROMPT_MODEL=gpt-5.6-sol
VAPI_AUDIT_MODEL=gpt-5.6-luna

# Legacy OpenRouter settings are used only with PROMPT_PROVIDER=openrouter.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Fallback model for the first four generation stages.
OPENROUTER_PROMPT_MODEL=google/gemini-3.7-flash

# Optional per-stage overrides.
# OPENROUTER_SKELETON_MODEL=google/gemini-3.7-flash
# OPENROUTER_CAST_MODEL=google/gemini-3.7-flash
# OPENROUTER_STORY_MODEL=google/gemini-3.7-flash
# OPENROUTER_RENDER_MODEL=google/gemini-3.7-flash
OPENROUTER_AUDIT_MODEL=openai/gpt-5.6-luna

# Optional OpenRouter attribution header.
# OPENROUTER_SITE_URL=https://your-project.example
